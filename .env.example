GATEWAY_DOMAIN=hooks.aricrm.co
# Only for temporary pre-DNS smoke tests; production uses the default Caddyfile and HTTPS.
# CADDYFILE=./Caddyfile.http
POSTGRES_PASSWORD=replace-with-strong-random-value
INGRESS_TOKEN=replace-with-separate-strong-random-value
METRICS_TOKEN=replace-with-another-strong-random-value
TARGET_URL=https://app.aricrm.co/api/v1/webhooks/evolution?apikey=replace-with-aricrm-evolution-key
WORKERS=4
TARGET_TIMEOUT_SECONDS=15
MAX_ATTEMPTS=12
DELIVERED_RETENTION_HOURS=72
# Optional alert endpoint. Leave blank to use only local syslog from monitor.sh.
ALERT_WEBHOOK_URL=
PENDING_AGE_ALERT_SECONDS=300
DLQ_ALERT_COUNT=1
DISK_ALERT_PERCENT=80
